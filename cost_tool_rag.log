b3i kh\xc3\xa1m ph\xc3\xb9 h\xe1\xbb\xa3p. Vui l\xc3\xb2ng li\xc3\xaan h\xe1\xbb\x87 tr\xe1\xbb\xb1c ti\xe1\xba\xbfp v\xe1\xbb\x9bi b\xe1\xbb\x87nh vi\xe1\xbb\x87n ho\xe1\xba\xb7c c\xc6\xa1 s\xe1\xbb\x9f y t\xe1\xba\xbf \xc4\x91\xe1\xbb\x83 \xc4\x91\xc6\xb0\xe1\xbb\xa3c t\xc6\xb0 v\xe1\xba\xa5n chi ti\xe1\xba\xbft.*\\n\\nDo kh\xc3\xb4ng c\xc3\xb3 g\xc3\xb3i kh\xc3\xa1m ph\xc3\xb9 h\xe1\xbb\xa3p trong d\xe1\xbb\xaf li\xe1\xbb\x87u, b\xe1\xba\xa1n n\xc3\xaan \xc4\x91i kh\xc3\xa1m b\xc3\xa1c s\xc4\xa9 chuy\xc3\xaan khoa th\xe1\xba\xa7n kinh \xc4\x91\xe1\xbb\x83 \xc4\x91\xc6\xb0\xe1\xbb\xa3c ch\xe1\xba\xa9n \xc4\x91o\xc3\xa1n v\xc3\xa0 t\xc6\xb0 v\xe1\xba\xa5n c\xe1\xbb\xa5 th\xe1\xbb\x83 h\xc6\xa1n v\xe1\xbb\x81 chi ph\xc3\xad kh\xc3\xa1m ch\xe1\xbb\xafa b\xe1\xbb\x87nh.\\n\\n{\\"diseases\\":[\\"R\xe1\xbb\x91i lo\xe1\xba\xa1n ti\xe1\xbb\x81n \xc4\x91\xc3\xacnh\\", \\"Thi\xe1\xba\xbfu m\xc3\xa1u n\xc3\xa3o\\", \\"Tho\xc3\xa1i h\xc3\xb3a \xc4\x91\xe1\xbb\x91t s\xe1\xbb\x91ng c\xe1\xbb\x95\\", \\"\xc4\x90au n\xe1\xbb\xada \xc4\x91\xe1\xba\xa7u\\", \\"H\xe1\xba\xa1 huy\xe1\xba\xbft \xc3\xa1p\\"], \\"packages\\":[], \\"advice_short\\":\\"Kh\xc3\xb4ng t\xc3\xacm th\xe1\xba\xa5y g\xc3\xb3i kh\xc3\xa1m ph\xc3\xb9 h\xe1\xbb\xa3p. N\xc3\xaan kh\xc3\xa1m b\xc3\xa1c s\xc4\xa9 chuy\xc3\xaan khoa th\xe1\xba\xa7n kinh.\\"}\\n"}]},"contextId":"487a119f-f615-4e3f-a724-b005619194ff","kind":"artifact-update","taskId":"9d127112-6351-4ef0-998a-581a4efd668e"}}\r\n\r\n'
